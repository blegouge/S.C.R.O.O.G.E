{
  "name": "scrooge-dashboard",
  "version": "1.4.3",
  "description": "SCROOGE Dashboard Frontend Tools",
  "private": true,
  "scripts": {
    "lint:js": "eslint \"dashboard/dashboard.js\" \"dashboard/dashboard_*.js\"",
    "lint:css": "stylelint \"dashboard/dashboard.css\"",
    "format:check": "prettier --check \"dashboard/dashboard.js\" \"dashboard/dashboard_*.js\" \"dashboard/dashboard.css\" \"dashboard/dashboard.html\"",
    "format:write": "prettier --write \"dashboard/dashboard.js\" \"dashboard/dashboard_*.js\" \"dashboard/dashboard.css\" \"dashboard/dashboard.html\"",

    "lint": "npm run lint:js && npm run lint:css && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  }
}
