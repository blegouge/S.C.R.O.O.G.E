# Copy to ~/.cursor/mcp.secrets.env (never commit the real file).
# Loaded by ~/.cursor/bin/mcp-env-exec.sh before every MCP server that needs credentials.

# Grafana
GRAFANA_API_TOKEN=

# Elasticsearch catalog
ES_USERNAME=
ES_PASSWORD=

# MySQL (bong + oxy share credentials in many setups)
MYSQL_PASSWORD=

# Datadog
DD_API_KEY=
DD_APP_KEY=

# Git hosts
GITHUB_PERSONAL_ACCESS_TOKEN=
GITLAB_TOKEN=
