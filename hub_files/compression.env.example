# Copy to ~/.gemini/antigravity/compression.env
# Loaded by hooks/semantic-compress-pretool.sh (Antigravity does not inherit terminal exports).

COMPRESSION_BACKEND=headroom
TASK_BRIEF_ENFORCE=deny
LLMLINGUA_HOOK_RATE=0.5
LLMLINGUA_HOOK_MIN_CHARS=2500
ADAPTIVE_CTX_TOKEN_THRESHOLD=4000
ADAPTIVE_CTX_MESSAGE_THRESHOLD=10
ADAPTIVE_CTX_STRUCTURE_MIN_INPUT_TOKENS=2500

# Headroom & CCR Local Configurations
CCR_ENABLED=1
CCR_THRESHOLD_CHARS=4000
SMART_CRUSHER_N=10
SMART_CRUSHER_M=10

# Optional: disable consumption report stop hook enforcement
# ANTIGRAVITY_CONSUMPTION_ENFORCE_DISABLE=1
# CURSOR_CONSUMPTION_ENFORCE_DISABLE=1

# Optional Claw tuning
# CLAW_COMPACTOR_ENABLED=1
# CLAW_COMPACTOR_MIN_SAVINGS_PCT=3
