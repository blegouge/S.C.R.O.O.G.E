# ==============================================================================
# Token Telemetry Config Template
# Copy to .env in this folder and configure variables as needed.
# ==============================================================================

# Port and host for the local HTTP Dashboard
TELEMETRY_PORT=8765
TELEMETRY_HOST=127.0.0.1

# Path to the active codebase root (used by code-explorer and setup)
CODEBASE_ROOT=~/www

# Default active context compression backend (claw, headroom, both, off)
COMPRESSION_BACKEND=claw

# ------------------------------------------------------------------------------
# Providers enabled (1 = enabled, 0 or absent = disabled)
# Uncomment the providers you want to enable
# ------------------------------------------------------------------------------
# TELEMETRY_CURSOR_ENABLED=1
# TELEMETRY_CLAUDE_ENABLED=1
# TELEMETRY_GEMINI_ENABLED=1
# TELEMETRY_ANTIGRAVITY_ENABLED=1
# TELEMETRY_HERMES_ENABLED=1
# TELEMETRY_CODEX_ENABLED=1

# ------------------------------------------------------------------------------
# IDE / Agent Hub Home Paths
# ------------------------------------------------------------------------------
CURSOR_HOME=~/.cursor
ANTIGRAVITY_HOME=~/.gemini/antigravity
CLAUDE_HOME=~/.claude
HERMES_HOME=~/.hermes
GEMINI_HOME=~/.gemini
CODEX_HOME=~/.codex

# ------------------------------------------------------------------------------
# IDE / Agent Telemetry stats directories (where events.jsonl is saved)
# ------------------------------------------------------------------------------
CURSOR_STATS_DIR=~/.cursor/token-telemetry
GEMINI_STATS_DIR=~/.gemini/antigravity/token-telemetry
CLAUDE_STATS_DIR=~/.claude/token-telemetry
HERMES_STATS_DIR=~/.hermes/token-telemetry
GEMINI_CLI_STATS_DIR=~/.gemini/token-telemetry
CODEX_STATS_DIR=~/.codex/token-telemetry
